// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function belongsToCompany(companyId) {
      return isSignedIn() && request.auth.token.companyId == companyId;
    }

    match /companies/{companyId} {
      allow read: if belongsToCompany(companyId);
      allow write: if false; // all writes go through Cloud Functions

      match /{subcollection=**} {
        allow read: if belongsToCompany(companyId);
        allow write: if false;
      }

      // POS writes tickets directly (no Cloud Function round-trip) so the
      // sale screen stays fast and this doubles as the write path offline
      // persistence will later replay. Scoped to the caller's own BU.
      match /businessUnits/{buId}/tickets/{ticketId} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId)
          && request.auth.token.role in ['operator', 'supervisor', 'admin']
          && (request.auth.token.role != 'operator' || buId in request.auth.token.businessUnitIds);
      }

      // Operator PINs live apart from the plain user doc (which is
      // company-wide readable) so they stay scoped to: Admin, the user
      // themselves, or a Supervisor who shares a business unit with them.
      match /users/{uid}/secure/{docId} {
        allow read: if belongsToCompany(companyId) && (
          request.auth.token.role == 'admin' ||
          request.auth.uid == uid ||
          (request.auth.token.role == 'supervisor' &&
            get(/databases/$(database)/documents/companies/$(companyId)/users/$(uid))
              .data.businessUnitIds.hasAny(request.auth.token.businessUnitIds))
        );
        allow write: if false;
      }
    }
  }
}